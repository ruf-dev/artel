# Env vars required to run this example (main.go) against the docker-compose
# Postgres in this directory. Copy/source this file, then `go run .`.
#
#   set -a && source required.env && set +a && go run .
#
# config/config.yaml in this directory already declares the servers/data_sources
# skeleton (see docs/embedding.md's "config-skeleton-plus-env-vars" section) --
# these env vars fill in the actual values, same as config/.env.example does
# for the root artel service.

DATA_SOURCES_POSTGRES_HOST=localhost
DATA_SOURCES_POSTGRES_PORT=15436
DATA_SOURCES_POSTGRES_USER=artel
DATA_SOURCES_POSTGRES_PWD=
DATA_SOURCES_POSTGRES_DB_NAME=artel_db
DATA_SOURCES_POSTGRES_SSL_MODE=disable

# Must match config/config.yaml's servers.MASTER port (8080) for a real `go run .`.
SERVERS_MASTER_PORT=8080

ENVIRONMENT_CREDS_ENCRYPTION_KEY=
ENVIRONMENT_GOOGLE_API_KEY=
ENVIRONMENT_GOOGLE_CLIENT_ID=
ENVIRONMENT_GOOGLE_CLIENT_SECRET=
ENVIRONMENT_LOG_FORMAT=TEXT
ENVIRONMENT_LOG_LEVEL=Info
# true skips the register/login flow, convenient for trying the example locally.
# Never set this on a real deployment.
ENVIRONMENT_NO_AUTH_ENABLED=true
ENVIRONMENT_OTEL_ENDPOINT=
ENVIRONMENT_SUBSCRIPTIONS_ENABLED=false
ENVIRONMENT_TELEGRAM_CLIENT_ID=
