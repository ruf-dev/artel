    "artel_notesCheckImportConflictsRequest": {
      "type": "object",
      "properties": {
        "vaultId": {
          "type": "string"
        },
        "destPath": {
          "type": "string",
          "title": "\"\" or \"/\" imports at vault root"
        },
        "zipData": {
          "type": "string",
          "format": "byte"
        }
      }
    },
    "artel_notesCheckImportConflictsResponse": {
      "type": "object",
      "properties": {
