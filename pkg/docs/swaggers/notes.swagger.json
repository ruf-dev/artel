      "type": "string",
      "enum": [
        "SKIP",
        "OVERWRITE",
        "RENAME"
      ],
      "default": "SKIP"
    },
    "artel_notesImportResolution": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "title": "conflicting destination path, as reported by CheckImportConflicts"
        },
        "action": {
          "$ref": "#/definitions/artel_notesImportConflictAction"
        },
        "renameTo": {
          "type": "string",
          "title": "only used when action == RENAME"
        }
      }
    },
