#!/bin/sh
# Enforces the repo's commit message convention: [Area] Category: description
# Activate with: git config core.hooksPath .githooks

MSG_FILE="$1"
SOURCE="$2"

# Don't validate merge commits
if [ "$SOURCE" = "merge" ] || head -n1 "$MSG_FILE" | grep -qE '^Merge '; then
    exit 0
fi

FIRST_LINE=$(head -n1 "$MSG_FILE")

PATTERN='^\[[^][]+\] (bug fixed|refactor|docs|chore|perf|[A-Z][A-Za-z0-9]*( [A-Za-z0-9]+)*): .+$'

if ! echo "$FIRST_LINE" | grep -qE "$PATTERN"; then
    echo "Commit message does not match the required format: [Area] Category: description" >&2
    echo "" >&2
    echo "  Area     - the part of the system changed, e.g. Tract, Connections, Auth" >&2
    echo "  Category - one of: bug fixed, refactor, docs, chore, perf" >&2
    echo "             or, for feature work, a Capitalized sub-area name (no literal 'feature')" >&2
    echo "" >&2
    echo "Examples:" >&2
    echo "  [Tract] bug fixed: connections created on the caller side, not the receiver" >&2
    echo "  [Tract] Canvas: added drag-select for nodes" >&2
    exit 1
fi

exit 0
